APP_NAME="Approid Desk"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://desk.approid.team
APP_TIMEZONE=Asia/Seoul
SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=180
APP_BIND_PORT=8080

APP_LOCALE=ko
APP_FALLBACK_LOCALE=ko
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=approid_desk
DB_USERNAME=approid_desk
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=desk.approid.team
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90

FILESYSTEM_DISK=local
ATTACHMENT_DISK=attachments
ATTACHMENT_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT=5
CLAMAV_READ_TIMEOUT=30

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=host.docker.internal
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=20
MAIL_EHLO_DOMAIN=desk.approid.team
MAIL_VERIFY_PEER=true
MAIL_FROM_ADDRESS=desk@approid.team
MAIL_FROM_NAME="Approid Desk"

VITE_APP_NAME="Approid Desk"
